<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="bootstrap.php"
         colors="true"
         backupGlobals="false"
         backupStaticAttributes="false">
    <php>
        <ini name="error_reporting" value="-1"/>
    </php>
    <testsuites>
        <testsuite name="ContactformModuleTests">
            <directory suffix="Test.php">php/Unit</directory>
            <exclude>php/Unit/UserAgentVersion902Test.php</exclude>
        </testsuite>
    </testsuites>
    <listeners>
        <listener class="ShuffledSuiteListener"/>
    </listeners>
</phpunit>
