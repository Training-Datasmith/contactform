<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php"
         colors="true"
         backupGlobals="false"
         backupStaticAttributes="false">
    <php>
        <ini name="error_reporting" value="-1"/>
    </php>
    <testsuites>
        <testsuite name="Contactform">
            <file>tests/php/ModuleShuffledSuite.php</file>
        </testsuite>
    </testsuites>
</phpunit>
